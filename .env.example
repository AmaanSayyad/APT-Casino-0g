# Copy this file to .env and fill in the values.
# Never commit .env — it contains private keys and secrets.

# --- Supabase ---
# Dashboard → Project Settings → API Keys (publishable + secret)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres for GameHistoryService (optional)
# Dashboard → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- WalletConnect ---
# Get a project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- 0G Networks (both Mainnet + Galileo Testnet supported) ---
NEXT_PUBLIC_SUPPORTED_NETWORKS=og-mainnet,og-galileo-testnet

# 0G Mainnet (chain ID 16661 / 0x4115)
NEXT_PUBLIC_0G_MAINNET_RPC=https://evmrpc.0g.ai
NEXT_PUBLIC_0G_MAINNET_CHAIN_ID=0x4115
NEXT_PUBLIC_0G_MAINNET_EXPLORER=https://chainscan.0g.ai

# 0G Galileo Testnet (chain ID 16602 / 0x40da)
NEXT_PUBLIC_0G_GALILEO_RPC=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_GALILEO_RPC_FALLBACK=https://evm-rpc-galileo.0g.ai
NEXT_PUBLIC_0G_GALILEO_CHAIN_ID=0x40da
NEXT_PUBLIC_0G_GALILEO_EXPLORER=https://chainscan-galileo.0g.ai

# --- Treasury ---
# The EVM address that holds house funds and signs withdrawals.
# NEXT_PUBLIC_TREASURY_ADDRESS is shown in the UI; TREASURY_ADDRESS is used server-side.
NEXT_PUBLIC_TREASURY_ADDRESS=
TREASURY_ADDRESS=

# --- Entropy oracle (Pyth — Arbitrum Sepolia) ---
# The treasury wallet must hold a small amount of Arbitrum Sepolia ETH to pay entropy fees.
NEXT_PUBLIC_ORACLE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_ORACLE_CHAIN_ID=421614
NEXT_PUBLIC_ORACLE_TX_EXPLORER=https://sepolia.arbiscan.io
NEXT_PUBLIC_PYTH_CHAIN_SLUG=arbitrum-sepolia

NEXT_PUBLIC_ENTROPY_NETWORK=entropy-testnet
NEXT_PUBLIC_CASINO_ENTROPY_NETWORK=arbitrum-sepolia

# Pyth Entropy contract + provider on Arbitrum Sepolia
NEXT_PUBLIC_PYTH_ENTROPY_CONTRACT=0x549ebba8036ab746611b4ffa1423eb0a4df61440
NEXT_PUBLIC_PYTH_ENTROPY_PROVIDER=0x6CC14824Ea2918f5De5C2f75A9Da968ad4BD6344

# Optional reference contracts (casino session / VRF)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_CASINO_CONTRACT=
NEXT_PUBLIC_CASINO_ENTROPY_CONTRACT=

NEXT_PUBLIC_ENTROPY_EXPLORER_URL=https://entropy-explorer.pyth.network
NEXT_PUBLIC_ENTROPY_EXPLORER_API=https://entropy-explorer.pyth.network/api

# --- Deposits / withdrawals ---
GAS_LIMIT_DEPOSIT=21000
GAS_LIMIT_WITHDRAW=100000
MIN_DEPOSIT=0.001
MAX_DEPOSIT=100

NEXT_PUBLIC_ENTROPY_FEE=0.001
NEXT_PUBLIC_GAS_LIMIT=500000
NEXT_PUBLIC_GAS_PRICE=20000000000

# --- App environment ---
# Canonical production URL (Vercel)
NEXT_PUBLIC_APP_URL=https://apt-casino-0g-gamma.vercel.app/
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=info

# --- Retry / timeout settings ---
NEXT_PUBLIC_ENTROPY_TIMEOUT=30000
NEXT_PUBLIC_MAX_RETRIES=3
NEXT_PUBLIC_RETRY_DELAY=1000

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_ENTROPY_EXPLORER=true
NEXT_PUBLIC_ENABLE_BATCH_REQUESTS=true
NEXT_PUBLIC_ENABLE_ENTROPY_VERIFICATION=true
NEXT_PUBLIC_ENABLE_ENTROPY_STATS=true

# --- Server-only secrets (never expose to the browser) ---
# Private key for the treasury wallet — must match TREASURY_ADDRESS above.
# Fund this address with OG on 0G Mainnet before accepting deposits/withdrawals.
TREASURY_PRIVATE_KEY=

# Optional: separate hot-wallet for casino session signing
CASINO_WALLET_PRIVATE_KEY=
